{
	admin off
	auto_https off
}

:8080 {
	root * /usr/share/caddy
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	@cacheable_static {
		path /assets/*
		path /schemas/*
		path /examples/*
	}
	header @cacheable_static Cache-Control "public, max-age=3600"

	file_server
}
