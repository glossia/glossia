msgstr "L'évaluation de la qualité de la traduction a échoué"

#: lib/glossia_web/live/dashboard_live.ex
#, elixir-autogen, elixir-format
msgid "Translation quality requirements were not met"
msgstr "Les exigences de qualité de la traduction n'ont pas été satisfaites."

#: lib/glossia_web/live/dashboard_live.ex
#, elixir-autogen, elixir-format
msgid "Use typesafe/jev-latest or a pinned TypeSafe Jev version. The default decision model evaluates translations automatically."
msgstr "Utilisez typesafe/jev-latest ou une version TypeSafe Jev fixée. Le modèle de décision par défaut évalue les traductions automatiquement."

