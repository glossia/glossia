<header class="site-header">
  <div class="container nav">
    <a class="logo" href={locale_path(~p"/")}>
      <img src={~p"/images/logo-rounded.png"} alt="" class="logo-icon" /> Glossia
    </a>
    <nav class="nav-links">
      <a href={locale_path(~p"/blog")}>{gettext("Blog")}</a>
      <a href={locale_path(~p"/features")}>{gettext("Features")}</a>
      <a href={locale_path(~p"/docs")}>{gettext("Docs")}</a>
      <a href={locale_path(~p"/changelog")}>{gettext("Changelog")}</a>
      <div id="language-switcher">
        <button data-part="toggle" aria-expanded="false" aria-haspopup="true">
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <circle cx="10" cy="10" r="7.25" stroke="currentColor" stroke-width="1.5" />
            <path
              d="M10 2.75c2 2 3 4.4 3 7.25s-1 5.25-3 7.25c-2-2-3-4.4-3-7.25s1-5.25 3-7.25ZM3 10h14"
              stroke="currentColor"
              stroke-width="1.5"
            />
          </svg>
          <span data-part="label">{Glossia.I18n.native_name(@locale)}</span>
        </button>
        <ul data-part="menu" role="menu" aria-label={gettext("Language")}>
          <li :for={locale <- Glossia.I18n.locales()} role="none">
            <a
              role="menuitem"
              lang={locale}
              hreflang={locale}
              aria-current={locale == @locale && "true"}
              href={
                ~p"/-/locale/#{Glossia.I18n.segment(locale)}?#{[return_to: GlossiaWeb.Layouts.current_path(assigns)]}"
              }
            >
              {Glossia.I18n.native_name(locale)}
            </a>
          </li>
        </ul>
      </div>
      <%= if assigns[:current_user] && @current_user do %>
        <div class="avatar-dropdown">
          <button class="avatar-toggle" aria-expanded="false" aria-haspopup="true">
            <img
              src={"https://www.gravatar.com/avatar/#{Base.encode16(:crypto.hash(:md5, String.downcase(String.trim(@current_user.email))), case: :lower)}?s=64&d=identicon"}
              alt={@current_user.name || @current_user.email}
              width="24"
              height="24"
            />
          </button>
          <ul class="avatar-menu" role="menu">
            <li role="none">
              <a role="menuitem" href={~p"/dashboard"}>{gettext("Your profile")}</a>
            </li>
            <li role="none" class="avatar-menu-divider"></li>
            <li role="none">
              <a role="menuitem" href={~p"/auth/logout"} data-method="delete">
                {gettext("Log out")}
              </a>
            </li>
          </ul>
        </div>
      <% else %>
        <a class="nav-cta" href={~p"/signup"}>{gettext("Get started")}</a>
      <% end %>
    </nav>
    <button class="mobile-menu-toggle" aria-expanded="false" aria-label={gettext("Menu")}>
      <svg
        class="menu-icon"
        width="20"
        height="20"
        viewBox="0 0 20 20"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M3 5h14M3 10h14M3 15h14"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
        />
      </svg>
      <svg
        class="close-icon"
        width="20"
        height="20"
        viewBox="0 0 20 20"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M5 5l10 10M15 5L5 15"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
        />
      </svg>
    </button>
  </div>
</header>

<.flash_group :if={assigns[:flash]} flash={@flash} />

<nav class="mobile-menu" aria-label="Mobile navigation">
  <a href={locale_path(~p"/blog")}>{gettext("Blog")}</a>
  <a href={locale_path(~p"/features")}>{gettext("Features")}</a>
  <a href={locale_path(~p"/docs")}>{gettext("Docs")}</a>
  <a href={locale_path(~p"/changelog")}>{gettext("Changelog")}</a>
  <details id="language-switcher-mobile">
    <summary>{Glossia.I18n.native_name(@locale)}</summary>
    <a
      :for={locale <- Glossia.I18n.locales()}
      lang={locale}
      hreflang={locale}
      href={
        ~p"/-/locale/#{Glossia.I18n.segment(locale)}?#{[return_to: GlossiaWeb.Layouts.current_path(assigns)]}"
      }
    >
      {Glossia.I18n.native_name(locale)}
    </a>
  </details>
  <%= if assigns[:current_user] && @current_user do %>
    <a href={~p"/dashboard"}>{gettext("Your profile")}</a>
    <a href={~p"/auth/logout"} data-method="delete">{gettext("Log out")}</a>
  <% else %>
    <a class="nav-cta" href={~p"/signup"}>{gettext("Get started")}</a>
  <% end %>
</nav>

<main>
  {@inner_content}
</main>

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a class="logo" href={locale_path(~p"/")}>
        <img src={~p"/images/logo-rounded.png"} alt="" class="logo-icon" /> Glossia
      </a>
      <p>{gettext("Built with love from Berlin.")}</p>
    </div>
    <div>
      <h4>{gettext("Navigate")}</h4>
      <ul class="legal-links">
        <li><a href={locale_path(~p"/blog")}>{gettext("Blog")}</a></li>
        <li><a href={locale_path(~p"/features")}>{gettext("Features")}</a></li>
        <li><a href={locale_path(~p"/docs")}>{gettext("Documentation")}</a></li>
        <li><a href={locale_path(~p"/changelog")}>{gettext("Changelog")}</a></li>
      </ul>
    </div>
    <div>
      <h4>{gettext("Legal")}</h4>
      <ul class="legal-links">
        <li><a href={locale_path(~p"/terms")}>{gettext("Terms of Service")}</a></li>
        <li><a href={locale_path(~p"/privacy")}>{gettext("Privacy Policy")}</a></li>
        <li><a href={locale_path(~p"/cookies")}>{gettext("Cookie Policy")}</a></li>
      </ul>
    </div>
  </div>
</footer>

<script>
  (function() {
    var menuBtn = document.querySelector('.mobile-menu-toggle');
    var mobileMenu = document.querySelector('.mobile-menu');
    if (menuBtn && mobileMenu) {
      menuBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        var isOpen = mobileMenu.classList.toggle('open');
        menuBtn.classList.toggle('open', isOpen);
        menuBtn.setAttribute('aria-expanded', isOpen);
      });
      mobileMenu.querySelectorAll('a').forEach(function(link) {
        link.addEventListener('click', function() {
          mobileMenu.classList.remove('open');
          menuBtn.classList.remove('open');
          menuBtn.setAttribute('aria-expanded', 'false');
        });
      });
    }

    var langDd = document.getElementById('language-switcher');
    if (langDd) {
      var langBtn = langDd.querySelector('[data-part="toggle"]');
      langBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        var isOpen = langDd.hasAttribute('data-open');
        if (isOpen) langDd.removeAttribute('data-open');
        else langDd.setAttribute('data-open', '');
        langBtn.setAttribute('aria-expanded', !isOpen);
      });
      document.addEventListener('click', function() {
        langDd.removeAttribute('data-open');
        langBtn.setAttribute('aria-expanded', 'false');
      });
    }

    var avatarDd = document.querySelector('.avatar-dropdown');
    if (avatarDd) {
      var avatarBtn = avatarDd.querySelector('.avatar-toggle');
      avatarBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        avatarDd.classList.toggle('open');
        avatarBtn.setAttribute('aria-expanded', avatarDd.classList.contains('open'));
      });
      document.addEventListener('click', function() {
        avatarDd.classList.remove('open');
        avatarBtn.setAttribute('aria-expanded', 'false');
      });
    }

    document.querySelectorAll('a[data-method="delete"]').forEach(function(link) {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        var form = document.createElement('form');
        form.method = 'POST';
        form.action = link.getAttribute('href');
        var csrf = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
        var csrfInput = document.createElement('input');
        csrfInput.type = 'hidden';
        csrfInput.name = '_csrf_token';
        csrfInput.value = csrf;
        form.appendChild(csrfInput);
        var methodInput = document.createElement('input');
        methodInput.type = 'hidden';
        methodInput.name = '_method';
        methodInput.value = 'delete';
        form.appendChild(methodInput);
        document.body.appendChild(form);
        form.submit();
      });
    });
  })();
</script>
