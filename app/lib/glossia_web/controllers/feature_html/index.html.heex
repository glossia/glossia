<section class="section feature-hero">
  <div class="container">
    <div class="feature-hero-content reveal">
      <h1>{gettext("Features")}</h1>
      <p class="lead">
        {gettext(
          "Explore the capabilities that make Glossia the content agent for your codebase. Each feature is designed to fit into your existing workflow."
        )}
      </p>
      <p>
        {gettext(
          "Community is open source under Apache-2.0. Enterprise adds organization single sign-on, audit logs, and isolated translation runners."
        )}
        <a href={locale_path(~p"/docs/explanation/editions")}>{gettext("Compare editions")}</a>
      </p>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="feature-index-grid">
      <a
        :for={page <- @pages}
        href={locale_path(~p"/features/#{page.slug}")}
        class="card feature-index-card reveal"
        data-interactive
      >
        <div class="feature-index-card-icon">
          {GlossiaWeb.FeatureHTML.feature_icon(page.icon, 24)}
        </div>
        <div class="feature-index-card-title">
          <h2>{page.title}</h2>
          <span class="feature-index-card-arrow">
            {GlossiaWeb.FeatureHTML.feature_icon("arrow-right", 16)}
          </span>
        </div>
        <Noora.Badge.badge label={
          if page.edition == "enterprise",
            do: gettext("Enterprise"),
            else: gettext("Community and Enterprise")
        } />
        <p>{page.summary}</p>
      </a>
    </div>
  </div>
</section>
