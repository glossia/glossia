<!DOCTYPE html>
<html lang={assigns[:locale] || Glossia.I18n.default_locale()}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{gettext("Too many requests · Glossia")}</title>
    <script>
      (function () {
        var dark =
          window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.style.setProperty("color-scheme", dark ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", dark ? "dark" : "light");
      })();
    </script>
    <style>
      :root {
        color-scheme: light dark;
        --bg: #ffffff;
        --fg: #0f172a;
        --muted: #475569;
        --accent: #4338ca;
        --border: #e2e8f0;
      }
      :root[data-theme="dark"] {
        --bg: #0f172a;
        --fg: #f1f5f9;
        --muted: #94a3b8;
        --accent: #a5b4fc;
        --border: #1e293b;
      }
      html, body { margin: 0; padding: 0; background: var(--bg); color: var(--fg); }
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
          "Helvetica Neue", Arial, sans-serif;
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 2rem 1rem;
        box-sizing: border-box;
      }
      main {
        max-width: 32rem;
        text-align: center;
      }
      h1 {
        font-size: 1.75rem;
        margin: 0 0 0.75rem;
        line-height: 1.2;
      }
      p {
        color: var(--muted);
        line-height: 1.55;
        margin: 0 0 0.75rem;
      }
      p.status {
        display: inline-block;
        margin: 1rem 0;
        padding: 0.35rem 0.75rem;
        border: 1px solid var(--border);
        border-radius: 999px;
        color: var(--muted);
        font-size: 0.85rem;
        letter-spacing: 0.02em;
        text-transform: uppercase;
      }
      a {
        color: var(--accent);
        text-decoration: none;
        border-bottom: 1px solid transparent;
      }
      a:hover, a:focus { border-bottom-color: var(--accent); }
    </style>
  </head>
  <body>
    <main>
      <p class="status">{gettext("HTTP 429")}</p>
      <h1>{gettext("Slow down for a moment")}</h1>
      <p>
        {gettext(
          "This page has received a lot of requests in a short time from your network. Try again in %{seconds} seconds.",
          seconds: assigns[:retry_after] || 60
        )}
      </p>
      <p>
        <a href={~p"/"}>{gettext("Back to Glossia")}</a>
      </p>
    </main>
  </body>
</html>
