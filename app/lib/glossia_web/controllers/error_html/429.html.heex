<!DOCTYPE html>
<html lang={assigns[:locale] || Glossia.I18n.default_locale()}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{gettext("Too many requests · Glossia")}</title>
    <link
      rel="stylesheet"
      href={
        Phoenix.VerifiedRoutes.static_path(
          GlossiaWeb.Endpoint,
          Application.get_env(:glossia, :asset_paths, %{})[:stylesheet] || "/assets/styles.css"
        )
      }
    />
    <link
      rel="stylesheet"
      href={
        Phoenix.VerifiedRoutes.static_path(
          GlossiaWeb.Endpoint,
          Application.get_env(:glossia, :asset_paths, %{})[:noora_stylesheet] ||
            "/assets/noora.css"
        )
      }
    />
    <style>
      html, body {
        margin: 0;
        padding: 0;
        background: var(--color-surface);
        color: var(--color-text);
      }
      body {
        font-family: var(--font-family-sans);
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: var(--space-4, 2rem) var(--space-3, 1rem);
        box-sizing: border-box;
      }
      main {
        max-width: 32rem;
        text-align: center;
      }
      h1 {
        font-size: 1.75rem;
        margin: 0 0 0.75rem;
        line-height: 1.2;
      }
      p {
        color: var(--color-text-muted);
        line-height: 1.55;
        margin: 0 0 0.75rem;
      }
      p.status {
        display: inline-block;
        margin: 1rem 0;
        padding: 0.35rem 0.75rem;
        border: 1px solid var(--color-border);
        border-radius: 999px;
        color: var(--color-text-muted);
        font-size: 0.85rem;
        letter-spacing: 0.02em;
        text-transform: uppercase;
      }
      a {
        color: var(--color-primary);
        text-decoration: none;
        border-bottom: 1px solid transparent;
      }
      a:hover, a:focus { border-bottom-color: var(--color-primary); }
    </style>
  </head>
  <body>
    <main>
      <p class="status">{gettext("HTTP 429")}</p>
      <h1>{gettext("Slow down for a moment")}</h1>
      <p>
        {gettext(
          "This page has received a lot of requests in a short time from your network. Try again in %{seconds} seconds.",
          seconds: assigns[:retry_after] || 60
        )}
      </p>
      <p>
        <a href={~p"/"}>{gettext("Back to Glossia")}</a>
      </p>
    </main>
  </body>
</html>
