<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=1200" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'none'; style-src 'unsafe-inline'; img-src data:; font-src data:"
    />
    <style>
      <%= Phoenix.HTML.raw(@styles) %>
    </style>
    <style>
      <%= Phoenix.HTML.raw(@noora) %>
    </style>
    <style>
      @font-face { font-family: "Social Inter"; src: url("<%= Phoenix.HTML.raw(@font) %>"); font-weight: 100 900; }
      @font-face { font-family: "Source Serif 4"; src: url("<%= Phoenix.HTML.raw(@serif_font) %>"); font-weight: 200 900; }
    </style>
  </head>
  <body id="social-image">
    <div data-part="geometry" aria-hidden="true"><span></span><span></span><span></span></div>
    <main>
      <img data-part="project-logo" src={@logo || @brand} alt="" />
      <.badge label={@category} color="primary" style="light-fill" size="large" />
      <h1>{@title}</h1>
      <p :if={@description != ""}>{@description}</p>
    </main>
    <footer>
      <div data-part="brand">
        <img src={@brand} alt="" />
        <span>Glossia</span>
      </div>
      <span data-part="domain">glossia.ai</span>
    </footer>
  </body>
</html>
