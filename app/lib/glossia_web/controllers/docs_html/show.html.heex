<article id="docs-article" class="prose">
  <header data-part="article-header">
    <nav data-part="breadcrumbs" aria-label={gettext("Breadcrumbs")}>
      <a href={locale_path(~p"/docs")}>{gettext("Documentation")}</a>
      <span>/</span>
      <a href={locale_path(~p"/docs/#{@current_category}")}>
        {@categories[@current_category].title}
      </a>
      <%= if assigns[:current_subcategory] do %>
        <span>/</span>
        <a href={locale_path(~p"/docs/#{@current_category}/#{@current_subcategory}")}>
          {@current_subcategory_meta.title}
        </a>
      <% end %>
      <span>/</span>
      <span>{@page.title}</span>
    </nav>
    <h1>{@page.title}</h1>
    <p data-part="availability">
      <span data-part="edition">
        <span>{gettext("Edition:")}</span>
        <Noora.Badge.badge
          style="light-fill"
          size="large"
          label={
            if @page.edition == "enterprise",
              do: gettext("Enterprise"),
              else: gettext("Community and Enterprise")
          }
        />
      </span>
      <a
        :if={@page.id != "explanation/editions"}
        href={locale_path(~p"/docs/explanation/editions")}
      >
        {gettext("Compare editions")}
      </a>
    </p>
    <p>{@page.summary}</p>
  </header>

  {raw(@page.body)}
</article>
