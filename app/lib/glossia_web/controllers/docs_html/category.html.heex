<section id="docs-category">
  <header data-part="page-intro">
    <nav data-part="breadcrumbs" aria-label={gettext("Breadcrumbs")}>
      <a href={locale_path(~p"/docs")}>{gettext("Documentation")}</a>
      <span>/</span>
      <span>{@category_meta.title}</span>
    </nav>
    <h1>{@category_meta.title}</h1>
    <p>{@category_meta.summary}</p>
  </header>

  <div data-part="page-list" data-count={length(@items)}>
    <a :for={item <- @items} id={item.id} href={item.href} data-part="page-card">
      <.card icon={item.icon} title={item.title}>
        <.card_section>
          <p>{item.summary}</p>
        </.card_section>
      </.card>
    </a>
  </div>
</section>
