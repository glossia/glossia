<% example_translations = [
  {"es", "Estás en tu casa.", "Siéntase como en casa."},
  {"de", "Fühl dich wie zu Hause.", "Fühlen Sie sich wie zu Hause."},
  {"ja", "どうぞ、くつろいで。", "どうぞ、ごゆっくりおくつろぎください。"}
] %>
<div id="home">
  <section data-part="hero" aria-labelledby="home-title">
    <div class="container">
      <p data-part="eyebrow">{gettext("Language OS")}</p>
      <h1 id="home-title">
        {gettext("Your voice.")} <em>{gettext("Every language.")}</em>
      </h1>
      <p data-part="lead">
        {gettext(
          "AI localization for your product and docs. Your voice in every language. Your translations, reviewed in Git."
        )}
      </p>
      <div data-part="cta-row">
        <Noora.Button.button href={~p"/signup"} label={gettext("Get early access")} size="large">
          <:icon_right><Noora.Icon.icon name="arrow_right" /></:icon_right>
        </Noora.Button.button>
        <Noora.Button.button
          href={locale_path(~p"/#how-it-works")}
          label={gettext("See how it works")}
          variant="secondary"
          size="large"
        />
      </div>
      <p data-part="onboarding-note">{gettext("Built with care. Onboarding teams gradually.")}</p>

      <div data-part="workspace">
        <Noora.Card.card title={gettext("From your voice to your repository")} icon="language">
          <:actions>
            <Noora.Badge.badge
              label={gettext("Example workspace")}
              style="light-fill"
              size="large"
            />
          </:actions>
          <div data-part="example-grid">
            <Noora.Card.card_section data-part="voice">
              <span data-part="panel-label">
                <Noora.Icon.icon name="books" /> {gettext("Brand voice")} <span>L10N.md</span>
              </span>
              <p data-part="voice-description" data-example-brief="informal">
                {gettext("A warm welcome. Never a literal translation.")}
              </p>
              <p data-part="voice-description" data-example-brief="formal" hidden>
                {gettext("A thoughtful welcome. A little more formal.")}
              </p>
              <div data-part="voice-tags">
                <Noora.Tag.tag label={gettext("Warm")} />
                <Noora.Tag.tag label={gettext("Clear")} />
                <Noora.Tag.tag label={gettext("Always you")} />
              </div>
              <div data-part="voice-choice">
                <p>{gettext("Try a different voice")}</p>
                <div role="group" aria-label={gettext("Example voice")} data-part="voice-controls">
                  <Noora.Button.button
                    :for={
                      {voice, label} <- [
                        {"informal", gettext("Informal")},
                        {"formal", gettext("Formal")}
                      ]
                    }
                    label={label}
                    variant="secondary"
                    size="medium"
                    type="button"
                    data-example-voice={voice}
                    aria-pressed={to_string(voice == "informal")}
                    aria-controls="home-preview home-files"
                  />
                </div>
              </div>
              <span data-part="context-note">
                <Noora.Icon.icon name="check" /> {gettext("Shared across your projects")}
              </span>
            </Noora.Card.card_section>
            <Noora.Card.card_section data-part="content-example">
              <div data-part="example-toolbar">
                <span data-part="panel-label">{gettext("Your translated content")}</span>
                <div role="group" aria-label={gettext("Example view")} data-part="view-controls">
                  <Noora.Button.button
                    :for={
                      {view, label} <- [
                        {"preview", gettext("Preview")},
                        {"files", gettext("Files")}
                      ]
                    }
                    label={label}
                    variant="secondary"
                    size="medium"
                    type="button"
                    data-example-view={view}
                    aria-pressed={to_string(view == "preview")}
                    aria-controls={"home-#{view}"}
                  />
                </div>
              </div>
              <div
                data-part="translation-controls"
                role="group"
                aria-label={gettext("Example language")}
              >
                <Noora.Button.button
                  :for={
                    {language, label} <- [{"es", "Español"}, {"de", "Deutsch"}, {"ja", "日本語"}]
                  }
                  label={label}
                  variant="secondary"
                  size="medium"
                  type="button"
                  lang={language}
                  data-example-language={language}
                  aria-pressed={to_string(language == "es")}
                  aria-controls={"home-translation-#{language} home-file-#{language}"}
                />
              </div>
              <div id="home-preview" data-example-panel="preview">
                <div data-part="source">
                  <span data-part="panel-label">
                    {gettext("Original")} <span lang="en">EN</span>
                  </span>
                  <p lang="en">Make yourself at home.</p>
                </div>
                <div data-part="translation-output" aria-live="polite" aria-atomic="true">
                  <p
                    :for={{language, informal, formal} <- example_translations}
                    id={"home-translation-#{language}"}
                    data-part="translation"
                    lang={language}
                    data-informal={informal}
                    data-formal={formal}
                    hidden={language != "es"}
                  >
                    {informal}
                  </p>
                </div>
              </div>
              <div id="home-files" data-example-panel="files" hidden>
                <p data-part="file-explanation">
                  {gettext("The same words, in files your application can use.")}
                </p>
                <div aria-live="polite" aria-atomic="true">
                  <div
                    :for={{language, informal, _formal} <- example_translations}
                    id={"home-file-#{language}"}
                    data-example-file={language}
                    hidden={language != "es"}
                  >
                    <span data-part="file-name">
                      <Noora.Icon.icon name="file_text" /> locales/{language}.json
                    </span>
                    <pre data-part="file-content"><code lang={language}>{"{\n  \"welcome\": #{JSON.encode!(informal)}\n}"}</code></pre>
                  </div>
                </div>
              </div>
            </Noora.Card.card_section>
          </div>
          <Noora.Card.card_section data-part="review-summary">
            <Noora.Icon.icon name="git_branch" />
            <div>
              <strong>{gettext("Your repository. Your review.")}</strong>
              <p>{gettext("Translations arrive as pull requests. You decide what ships.")}</p>
            </div>
            <a href={locale_path(~p"/docs/tutorials/getting-started")}>
              {gettext("Explore the workflow")} <Noora.Icon.icon name="arrow_right" />
            </a>
          </Noora.Card.card_section>
        </Noora.Card.card>
        <p data-part="example-caption">
          {gettext("Change the voice. Keep the meaning.")}
        </p>
      </div>

      <div data-part="builders">
        <span>{gettext("From builders who worked at")}</span>
        <div data-part="builder-logos">
          <a href="https://soundcloud.com" target="_blank" rel="noopener noreferrer">
            <img src={~p"/assets/logos/soundcloud.svg"} alt="SoundCloud" width="112" height="16" />
          </a>
          <a href="https://www.shopify.com" target="_blank" rel="noopener noreferrer">
            <img src={~p"/assets/logos/shopify.svg"} alt="Shopify" width="96" height="28" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="how-it-works" data-part="section" aria-labelledby="how-it-works-title">
    <div class="container">
      <div data-part="section-heading">
        <p data-part="eyebrow">{gettext("How Glossia works")}</p>
        <h2 id="how-it-works-title">{gettext("From your words to the world.")}</h2>
      </div>
      <ol data-part="workflow">
        <li :for={
          {number, icon, title, description} <- [
            {"01", "books", gettext("Set your voice."),
             gettext(
               "Define tone and terminology once. Reuse them across projects and languages."
             )},
            {"02", "brand_github", gettext("Connect your content."),
             gettext(
               "Keep source and translated files in Git, alongside the code that uses them."
             )},
            {"03", "circle_check", gettext("Review and ship."),
             gettext("Review translation pull requests with your team. Merge when you're ready.")}
          ]
        }>
          <Noora.Card.card_section>
            <div data-part="step-heading" aria-hidden="true">
              <Noora.Icon.icon name={icon} /> <span>{number}</span>
            </div>
            <h3>{title}</h3>
            <p>{description}</p>
          </Noora.Card.card_section>
        </li>
      </ol>
      <div data-part="workflow-links">
        <a href={locale_path(~p"/docs/tutorials/getting-started")}>
          {gettext("Take the quick tour")} <Noora.Icon.icon name="arrow_right" />
        </a>
        <a href={locale_path(~p"/docs/reference/api")}>
          {gettext("API reference")} <Noora.Icon.icon name="arrow_right" />
        </a>
      </div>
    </div>
  </section>

  <section id="editions" data-part="section" aria-labelledby="editions-title">
    <div class="container">
      <div data-part="section-heading">
        <p data-part="eyebrow">{gettext("Open by design")}</p>
        <h2 id="editions-title">{gettext("Your language. Your way.")}</h2>
        <p>{gettext("An open-source foundation. Extra controls when your team needs them.")}</p>
      </div>
      <div data-part="edition-grid">
        <Noora.Card.card_section
          data-edition="community"
          aria-labelledby="community-edition-title"
        >
          <div data-part="edition-header">
            <h3 id="community-edition-title">{gettext("Community")}</h3>
            <Noora.Badge.badge label="Apache-2.0" style="light-fill" size="large" />
          </div>
          <p data-part="description">
            {gettext("The essentials for working across languages. Open source, always.")}
          </p>
          <ul data-part="features">
            <li :for={
              feature <- [
                gettext("Repository translation"),
                gettext("Shared voice and glossary"),
                gettext("APIs and analytics")
              ]
            }>
              <span data-part="feature-icon" aria-hidden="true">
                <Noora.Icon.icon name="check" />
              </span>
              {feature}
            </li>
          </ul>
          <Noora.Button.button
            href="https://github.com/glossia/glossia"
            label={gettext("Explore the source")}
            variant="secondary"
          >
            <:icon_left><Noora.Icon.icon name="brand_github" /></:icon_left>
          </Noora.Button.button>
        </Noora.Card.card_section>
        <Noora.Card.card_section
          data-edition="enterprise"
          aria-labelledby="enterprise-edition-title"
        >
          <div data-part="edition-header">
            <h3 id="enterprise-edition-title">{gettext("Enterprise")}</h3>
            <Noora.Badge.badge
              label={gettext("Commercial license")}
              color="primary"
              style="light-fill"
              size="large"
            />
          </div>
          <p data-part="description">
            {gettext("Everything in Community, with more control for your organization.")}
          </p>
          <ul data-part="features">
            <li :for={
              feature <- [
                gettext("Single sign-on"),
                gettext("Audit logs"),
                gettext("Isolated translation runners")
              ]
            }>
              <span data-part="feature-icon" aria-hidden="true">
                <Noora.Icon.icon name="check" />
              </span>
              {feature}
            </li>
          </ul>
          <Noora.Button.button
            href="mailto:contact@glossia.ai"
            label={gettext("Talk to us")}
            variant="secondary"
          >
            <:icon_left><Noora.Icon.icon name="mail" /></:icon_left>
          </Noora.Button.button>
        </Noora.Card.card_section>
      </div>
      <a data-part="comparison" href={locale_path(~p"/docs/explanation/editions")}>
        {gettext("Compare Community and Enterprise")} <Noora.Icon.icon name="arrow_right" />
      </a>
    </div>
  </section>

  <section data-part="section" aria-labelledby="home-questions-title">
    <div class="container" data-part="questions-layout">
      <div>
        <p data-part="eyebrow">{gettext("A little more context")}</p>
        <h2 id="home-questions-title">{gettext("Good questions.")}</h2>
        <p>
          {gettext("There's a human behind every great translation. And behind Glossia, too.")}
        </p>
        <a href="https://community.glossia.ai" target="_blank" rel="noopener noreferrer">
          {gettext("Visit the forum")} <Noora.Icon.icon name="arrow_right" />
        </a>
      </div>
      <div class="faq" data-part="questions">
        <details>
          <summary>{gettext("Where does my content live?")}</summary>
          <p>
            {gettext(
              "In your repository. Translations arrive as pull requests, so your team keeps its existing review process and version history."
            )}
          </p>
          <a href={locale_path(~p"/docs/explanation/content-ownership")}>
            {gettext("More about content ownership")}
          </a>
        </details>
        <details>
          <summary>{gettext("Where do humans participate?")}</summary>
          <p>
            {gettext(
              "Your team defines the voice and terminology, reviews translations, and refines the result. AI handles the repetitive work; people shape the language."
            )}
          </p>
        </details>
        <details>
          <summary>{gettext("Do I need to bring my own models?")}</summary>
          <p>
            {gettext(
              "No. Glossia provides model defaults, and you can configure your own providers when you need more control."
            )}
          </p>
        </details>
      </div>
    </div>
  </section>

  <section :if={@posts != []} data-part="section" aria-labelledby="home-blog-title">
    <div class="container">
      <div data-part="journal-heading">
        <h2 id="home-blog-title">{gettext("Notes from the workshop.")}</h2>
        <a href={locale_path(~p"/blog")}>
          {gettext("View all posts")} <Noora.Icon.icon name="arrow_right" />
        </a>
      </div>
      <div data-part="journal-grid">
        <Noora.Card.card_section :for={post <- @posts}>
          <a href={locale_path(~p"/blog/#{post.slug}")}>
            <time datetime={Date.to_iso8601(post.date)}>
              {GlossiaWeb.BlogHTML.format_date(post.date)}
            </time>
            <h3>{post.title}</h3>
            <span data-part="post-author">
              {post.author.name} <Noora.Icon.icon name="arrow_right" />
            </span>
          </a>
        </Noora.Card.card_section>
      </div>
    </div>
  </section>

  <section data-part="closing" aria-labelledby="home-closing-title">
    <div class="container">
      <p data-part="eyebrow">{gettext("A world of possibility")}</p>
      <h2 id="home-closing-title">
        {gettext("Make yourself understood.")} <em>{gettext("Everywhere.")}</em>
      </h2>
      <p>{gettext("Bring your voice. We'll help it travel.")}</p>
      <Noora.Button.button href={~p"/signup"} label={gettext("Get early access")} size="large">
        <:icon_right><Noora.Icon.icon name="arrow_right" /></:icon_right>
      </Noora.Button.button>
      <p data-part="onboarding-note">
        {gettext("We're onboarding teams gradually. Let's find your fit.")}
      </p>
    </div>
  </section>
</div>

<script>
  (() => {
    const home = document.getElementById("home");
    const buttons = home.querySelectorAll("[data-example-language]");
    const translations = home.querySelectorAll('[data-part="translation"]');
    const files = home.querySelectorAll("[data-example-file]");
    const views = home.querySelectorAll("[data-example-view]");
    const panels = home.querySelectorAll("[data-example-panel]");
    const voices = home.querySelectorAll("[data-example-voice]");
    const briefs = home.querySelectorAll("[data-example-brief]");

    buttons.forEach(button => {
      button.addEventListener("click", () => {
        const language = button.dataset.exampleLanguage;
        buttons.forEach(control => {
          control.setAttribute("aria-pressed", String(control === button));
        });
        translations.forEach(translation => {
          translation.hidden = translation.lang !== language;
        });
        files.forEach(file => {
          file.hidden = file.dataset.exampleFile !== language;
        });
      });
    });

    views.forEach(button => {
      button.addEventListener("click", () => {
        views.forEach(control => {
          control.setAttribute("aria-pressed", String(control === button));
        });
        panels.forEach(panel => {
          panel.hidden = panel.dataset.examplePanel !== button.dataset.exampleView;
        });
      });
    });

    voices.forEach(button => {
      button.addEventListener("click", () => {
        const voice = button.dataset.exampleVoice;
        voices.forEach(control => {
          control.setAttribute("aria-pressed", String(control === button));
        });
        briefs.forEach(brief => {
          brief.hidden = brief.dataset.exampleBrief !== voice;
        });
        translations.forEach(translation => {
          translation.textContent = translation.dataset[voice];
        });
        files.forEach(file => {
          const translation = home.querySelector(`#home-translation-${file.dataset.exampleFile}`);
          file.querySelector("code").textContent = JSON.stringify({ welcome: translation.dataset[voice] }, null, 2);
        });
      });
    });
  })();
</script>
