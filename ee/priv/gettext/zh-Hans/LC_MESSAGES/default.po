msgid "Domain ownership verified."
msgstr "域名所有权已验证。"

#, elixir-autogen, elixir-format
msgid "Enter your client secret"
msgstr "输入您的客户端密钥"

#, elixir-autogen, elixir-format
msgid "Enter your work email domain and save the authentication settings."
msgstr "输入您的工作邮箱域名并保存身份验证设置。"

