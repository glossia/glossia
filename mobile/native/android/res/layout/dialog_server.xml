<com.google.android.material.textfield.TextInputLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="24dp"
    android:hint="Server address" app:placeholderText="https://glossia.example.com">
    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/server_address" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:inputType="textUri" android:singleLine="true" android:imeOptions="actionGo" />
</com.google.android.material.textfield.TextInputLayout>
